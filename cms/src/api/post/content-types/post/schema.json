{
  "kind": "collectionType",
  "collectionName": "posts",
  "info": {
    "singularName": "post",
    "pluralName": "posts",
    "displayName": "Post",
    "description": "Artículos del blog de Grupo Mizar"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "description": {
      "type": "text",
      "required": true
    },
    "content": {
      "type": "blocks"
    },
    "author": {
      "type": "string",
      "default": "Grupo Mizar"
    },
    "frente": {
      "type": "string",
      "default": "blog"
    },
    "tags": {
      "type": "string"
    },
    "hero_image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "pub_date": {
      "type": "date"
    }
  }
}
