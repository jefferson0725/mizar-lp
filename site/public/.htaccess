Options -MultiViews

RewriteEngine On

# Si el archivo o directorio existe, sírvelo directamente
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Intenta con /ruta/index.html (rutas de Astro)
RewriteCond %{DOCUMENT_ROOT}%{REQUEST_URI}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

# Si no existe, devuelve 404 personalizado
ErrorDocument 404 /404.html

# ---------------------------------------------------------------------------
# Cache headers
# ---------------------------------------------------------------------------

# Assets hasheados de Astro (/_astro/) — inmutables, 1 año
<IfModule mod_headers.c>
  <FilesMatch "^_astro/">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  # Astro hashed assets (CSS, JS, fonts con hash)
  <FilesMatch "\.(css|js|woff2|woff|ttf|otf)$">
    ExpiresDefault "access plus 1 year"
  </FilesMatch>

  # Imágenes estáticas — 30 días (sin hash, pueden cambiar)
  ExpiresByType image/webp          "access plus 30 days"
  ExpiresByType image/png           "access plus 30 days"
  ExpiresByType image/jpeg          "access plus 30 days"
  ExpiresByType image/jpg           "access plus 30 days"
  ExpiresByType image/svg+xml       "access plus 30 days"
  ExpiresByType image/x-icon        "access plus 30 days"
  ExpiresByType image/vnd.microsoft.icon "access plus 30 days"
  ExpiresByType image/avif          "access plus 30 days"

  # Videos — 30 días
  ExpiresByType video/mp4           "access plus 30 days"
  ExpiresByType video/webm          "access plus 30 days"

  # HTML — sin cache (rutas pueden cambiar en cada deploy)
  ExpiresByType text/html           "access plus 0 seconds"
</IfModule>

# Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
