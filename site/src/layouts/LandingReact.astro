---
// Layout mínimo para las landings React (Laureles Campestre y Terrazas).
// No usa Base.astro: estas páginas traen su propio Tailwind (@theme de la
// landing), tipografías Fraunces/DM Sans y no llevan header/footer del sitio.
import "../landing/index.css";
import "@fontsource-variable/fraunces/opsz.css";
import "@fontsource-variable/dm-sans/wght.css";
import "@fontsource-variable/archivo";
import Analytics from "../components/Analytics.astro";
import { orgSchema } from "../data/schema";

interface Props {
  title: string;
  description: string;
  ogImage: string;
  path: string;
  headerColor?: string;
  headerColorDark?: string;
  noindex?: boolean;
  /** JSON-LD adicional de la página (Organization ya va global) */
  schema?: object | object[];
}

const { title, description, ogImage, path, headerColor = '#22484c', headerColorDark = '#17333a', noindex = false, schema } = Astro.props;
const site = Astro.site ?? new URL('https://grupomizar.com.co');
const canonicalPath = path === '/' ? '/' : `${path.replace(/\/+$/, '')}/`;
const canonical = new URL(canonicalPath, site).href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon.png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#0a2342" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grupo Mizar" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, site).href} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_CO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(ogImage, site).href} />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
    {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
    <style set:html={`:root{--color-plum:${headerColor};--color-plum-dark:${headerColorDark};}`}></style>
    <script is:inline type="text/javascript">
      window.addEventListener('load', function() {
        setTimeout(function() {
          (function(c,l,a,r,i,t,y){
            c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
            t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
            y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
          })(window, document, "clarity", "script", "x4jt12aihp");
        }, 3000);
      });
    </script>
    <!-- Google Tag Manager (mismo contenedor que Base.astro: GA4 + Meta Pixel).
         Sin él, las landings de pauta no medían visitas ni clics a WhatsApp. -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
    new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
    j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
    'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
    })(window,document,'script','dataLayer','GTM-PH7QMF29');</script>
    <!-- End Google Tag Manager -->
    <Analytics />
  </head>
  <style is:global>
    /* Restaura los tokens del sitio principal en el header */
    [data-header] {
      --color-gold: #e0b973 !important;
      --color-mizar: #d72b47 !important;
      --color-teal: #1e3a5f !important;
      --color-ink: #1e2b2e !important;
      font-family: "Archivo Variable", ui-sans-serif, system-ui, sans-serif !important;
    }
    [data-header] a, [data-header] button, [data-header] nav {
      font-family: "Archivo Variable", ui-sans-serif, system-ui, sans-serif !important;
    }
  </style>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-PH7QMF29"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
  </body>
</html>
