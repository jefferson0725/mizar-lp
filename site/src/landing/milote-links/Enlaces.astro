  },
  {
    nombre: "Facebook",
    viewBox: "0 0 24 24",
    href: "https://www.facebook.com/p/Milotecucuta-61575954394010/",
    event: "social-click",
    svgPath:
      "M22.675 0h-21.35C.6 0 0 .6 0 1.326v21.348C0 23.4.6 24 1.326 24H12.82v-9.294H9.692v-3.622h3.128V8.413c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.464.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12V24h6.116C23.4 24 24 23.4 24 22.674V1.326C24 .6 23.4 0 22.675 0z",
  },
];

const [whatsapp, instagram] = redes;

const botones = [
  { label: "Página Web", href: "/lotes-cucuta/", event: "linkinbio-click", externo: false, logo: true },
  { label: "WhatsApp", href: whatsapp.href, event: "whatsapp-click", externo: true, icono: whatsapp },
  { label: "Instagram", href: instagram.href, event: "social-click", externo: true, icono: instagram },
];
---

<div class="relative min-h-[100svh] overflow-hidden bg-[#2f2b27] text-white">
  <div
    aria-hidden="true"
    class="absolute inset-0 bg-[radial-gradient(ellipse_at_50%_35%,#5a5048_0%,#3c3631_45%,#2f2b27_100%)]"
  >
  </div>

  <main class="relative z-10 mx-auto w-full max-w-[580px] px-5 pt-20 pb-12 flex flex-col items-center">
    <div class="grid place-items-center w-24 h-24 rounded-full bg-white lnk-in" style="animation-delay:0s">
      <img src="/assets/logo-milote-icono.webp" alt="Mi Lote" width="256" height="256" class="w-14 h-14" />
    </div>

    <h1 class="mt-5 text-center text-[1.6rem] font-bold leading-tight lnk-in" style="animation-delay:0.05s">
      Mi Lote - Cúcuta
    </h1>
    <p class="mt-2 max-w-[18rem] text-center text-lg leading-snug text-white/90 lnk-in" style="animation-delay:0.1s">
      Paga a cuotas sin intereses, invierte fácil y seguro
    </p>

    <ul class="mt-8 w-full flex flex-col gap-3">
      {botones.map((b, i) => (
        <li class="lnk-in" style={`animation-delay:${0.15 + i * 0.07}s`}>
          <a
            href={b.href}
            target={b.externo ? "_blank" : undefined}
            rel={b.externo ? "noopener" : undefined}
            data-event={b.event}
            class="relative flex items-center justify-center w-full min-h-[64px] rounded-xl bg-black px-16 py-4 text-center text-[1.05rem] font-medium hover:scale-[1.02] transition-transform"
          >
            <span class="absolute left-4 top-1/2 -translate-y-1/2 grid place-items-center w-10 h-10" aria-hidden="true">
              {b.logo ? (
                <img src="/assets/logo-milote-icono.webp" alt="" width="256" height="256" class="w-9 h-9" />
              ) : (
                <svg viewBox={b.icono!.viewBox} width="34" height="34" fill="currentColor">
                  <path d={b.icono!.svgPath}></path>
                </svg>
              )}
            </span>
            {b.label}
          </a>
        </li>
      ))}
    </ul>

    <ul class="mt-8 flex items-center gap-6 lnk-in" style={`animation-delay:${0.15 + botones.length * 0.07}s`}>
      {redes.map((r) => (
        <li>
          <a
            href={r.href}
            target="_blank"
            rel="noopener"
            aria-label={`Mi Lote en ${r.nombre}`}
            data-event={r.event}
            class="block hover:opacity-75 transition-opacity"
          >
            <svg viewBox={r.viewBox} width="36" height="36" fill="currentColor" aria-hidden="true">
              <path d={r.svgPath}></path>
            </svg>
          </a>
        </li>
      ))}
    </ul>
  </main>
</div>
