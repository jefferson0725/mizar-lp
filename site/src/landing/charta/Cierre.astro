---
import { getImage } from "astro:assets";
import aereaImg from "../../assets/charta/charta-cabana-aerea.jpg";
import { getWhatsAppConfig } from "../../data/whatsapp";
const wa = getWhatsAppConfig("/parcelas-charta");
const WA_URL = `https://wa.me/${wa.phone}?text=${encodeURIComponent(wa.message)}`;

const bg = await getImage({ src: aereaImg, format: "webp", width: 1920 });
---

<section
  class="relative bg-cover bg-center py-24 md:py-36 px-6 text-center text-white"
  style={`background-image:url(${bg.src})`}
>
  <div class="absolute inset-0 bg-navy-dark/75"></div>
  <div class="relative z-10 max-w-3xl mx-auto">
    <h2 class="font-serif text-4xl md:text-6xl font-semibold leading-tight">
      Tu rincón florido en Charta te está esperando
    </h2>
    <p class="text-lg md:text-xl text-white/85 mt-5 max-w-2xl mx-auto">
      Habla con nosotros por WhatsApp y conoce tu parcela.
    </p>
    <a
      href={WA_URL}
      target="_blank"
      rel="noopener"
      data-event="whatsapp-click"
      class="inline-flex items-center justify-center gap-2 bg-rojo hover:bg-rojo-dark text-white font-bold px-12 py-5 rounded-lg text-xl transition-colors duration-300 shadow-hover mt-10"
    >
      <svg viewBox="0 0 32 32" width="24" height="24" fill="currentColor" aria-hidden="true">
        <path d="M16 3C9.373 3 4 8.373 4 15c0 2.25.62 4.36 1.7 6.16L4 29l8.05-1.65A11.9 11.9 0 0 0 16 27c6.627 0 12-5.373 12-12S22.627 3 16 3zm0 21.8c-1.9 0-3.68-.53-5.2-1.45l-.37-.22-4.78.98 1-4.65-.24-.39A9.77 9.77 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.38-7.34c-.3-.15-1.74-.86-2-.96-.27-.1-.47-.15-.66.15-.2.29-.76.95-.93 1.15-.17.2-.34.22-.64.07-.3-.14-1.24-.45-2.36-1.45-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.19.05-.36-.02-.5-.08-.15-.67-1.6-.91-2.2-.24-.57-.48-.5-.66-.5h-.56c-.2 0-.5.07-.77.36-.26.29-1 .98-1 2.4 0 1.4 1.03 2.77 1.17 2.96.15.2 2.03 3.1 4.92 4.34.69.3 1.22.47 1.64.6.69.22 1.32.19 1.81.12.55-.08 1.74-.71 1.98-1.4.25-.68.25-1.27.17-1.4-.07-.12-.27-.2-.57-.34z"/>
      </svg>
      Comunícate con nosotros
    </a>
  </div>
</section>
