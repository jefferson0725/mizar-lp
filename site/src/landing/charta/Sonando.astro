---
import { Image } from "astro:assets";
import vistaPueblo from "../../assets/charta/charta-vista-pueblo.jpg";

const items = [
  {
    titulo: "Silencio real",
    texto: "Sin tráfico, sin ruido, solo el sonido del bosque.",
    icon: `<path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 6.636a9 9 0 0 1 0 10.728"/>`,
  },
  {
    titulo: "Tranquilidad",
    texto: "Días lentos, sin afán, al ritmo de la montaña.",
    icon: `<path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/>`,
  },
  {
    titulo: "Agua pura del páramo",
    texto: "Nace en la montaña y llega limpia hasta tu parcela.",
    icon: `<path d="M12 22a7 7 0 0 0 7-7c0-2-1-3.9-3-5.5s-3.5-4-4-6.5c-.5 2.5-2 4.9-4 6.5C6 11.1 5 13 5 15a7 7 0 0 0 7 7Z"/>`,
  },
  {
    titulo: "Agricultura orgánica",
    texto: "Verduras y frutas que se cultivan a pocos minutos de ti.",
    icon: `<path d="M7 20h10"/><path d="M10 20c0-4.5-2-6-2-6"/><path d="M14 20c0-4.5 2-6 2-6"/><path d="M20 10c0 3-2 4-4 4a4 4 0 0 1-4-4 4 4 0 0 1 4-4c1.3 0 2.4.7 3 1.7"/><path d="M4 10c0 3 2 4 4 4"/>`,
  },
  {
    titulo: "Naturaleza exuberante",
    texto: "Montaña verde todo el año, a la vista desde tu terraza.",
    icon: `<path d="M10 10v.2A3 3 0 0 1 8.9 16H5a3 3 0 0 1-1-5.8V10a3 3 0 0 1 6 0Z"/><path d="M7 16v6"/><path d="M13 19v3"/><path d="M12 19h8.3a1 1 0 0 0 .7-1.7L18 14h.3a1 1 0 0 0 .7-1.7L16 9h.2a1 1 0 0 0 .8-1.7L13 3l-1.4 1.5"/>`,
  },
];
---

<section class="bg-crema py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto grid md:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-rojo">Desconecta de verdad</p>
      <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-tight text-navy mt-4">
        ¿Cuánto llevas soñando con un lugar así?
      </h2>
      <p class="text-lg text-gris-oscuro mt-5">
        Charta tiene lo que se te está acabando en la ciudad:
      </p>

      <ul class="mt-8 grid sm:grid-cols-2 gap-4">
        {items.map((item, i) => (
          <li class="reveal bg-white rounded-2xl shadow-card p-5 flex gap-4 items-start" style={`transition-delay:${i * 0.08}s`}>
            <span class="bg-navy/5 text-navy rounded-xl p-2.5 flex-shrink-0">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={item.icon}></svg>
            </span>
            <span>
              <span class="block font-semibold text-navy">{item.titulo}</span>
              <span class="block text-sm text-gris-oscuro mt-1">{item.texto}</span>
            </span>
          </li>
        ))}
      </ul>

      <p class="mt-6 font-serif text-xl text-navy">
        Un entorno ideal para desconectar en familia.
      </p>
    </div>

    <div class="relative">
      <Image
        src={vistaPueblo}
        alt="Vista del pueblo de Charta entre montañas de Santander"
        widths={[480, 768, 1024]}
        sizes="(min-width:768px) 35vw, 90vw"
        format="webp"
        class="hidden md:block absolute -z-10 right-0 top-8 w-[70%] h-[80%] object-cover rounded-3xl opacity-90"
      />
      <div class="relative mx-auto w-full max-w-[340px] aspect-[9/16] rounded-3xl overflow-hidden shadow-dark ring-8 ring-white">
        <video
          class="w-full h-full object-cover"
          muted
          loop
          playsinline
          autoplay
          preload="none"
          poster="/videos/posters/charta-amanecer.jpg"
          data-src="/videos/charta-amanecer.mp4"
        ></video>
        <span class="absolute bottom-4 left-4 bg-white/90 text-navy text-xs font-semibold px-3 py-1.5 rounded-full">
          Amanecer sobre Charta
        </span>
      </div>
    </div>
  </div>
</section>

<script>
  const video = document.querySelector<HTMLVideoElement>('video[data-src="/videos/charta-amanecer.mp4"]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (video && !reduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const src = video.dataset.src;
            if (src && !video.src.endsWith(src)) {
              video.src = src;
              video.play().catch(() => {});
            }
          }
        });
      },
      { threshold: 0.3 }
    );
    observer.observe(video);
  }
</script>
