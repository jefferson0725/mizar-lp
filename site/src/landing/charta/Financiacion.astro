---
import { getWhatsAppConfig } from "../../data/whatsapp";
const wa = getWhatsAppConfig("/parcelas-charta");
const WA_URL = `https://wa.me/${wa.phone}?text=${encodeURIComponent(wa.message)}`;

const items = [
  "Sin historial crediticio bancario",
  "Sin papeleo de banco",
  "Sin intereses ocultos",
];
---

<section class="bg-navy text-white py-20 md:py-28 px-6">
  <div class="max-w-6xl mx-auto grid lg:grid-cols-[1.1fr_0.9fr] gap-12 items-center">
    <div>
      <p class="text-xs font-semibold uppercase tracking-[0.2em] text-dorado">Financiación directa</p>
      <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-tight mt-4">
        Sin bancos, sin intermediarios, sin vueltas
      </h2>
      <p class="text-lg text-white/85 mt-5">
        Pagas a cuotas directamente con nosotros,
      </p>
      <p class="mt-4 font-serif text-4xl md:text-5xl text-dorado leading-tight">
        desde $3.000.000 <span class="text-2xl md:text-3xl text-white/80 font-sans font-normal">mensuales</span>
      </p>

      <ul class="mt-8 space-y-3">
        {items.map((item, i) => (
          <li class="reveal flex items-center gap-3" style={`transition-delay:${i * 0.08}s`}>
            <svg class="w-5 h-5 text-dorado flex-shrink-0" fill="currentColor" viewBox="0 0 448 512" aria-hidden="true">
              <path d="M224.3 273l-136 136c-9.4 9.4-24.6 9.4-33.9 0l-22.6-22.6c-9.4-9.4-9.4-24.6 0-33.9l96.4-96.4-96.4-96.4c-9.4-9.4-9.4-24.6 0-33.9L54.3 103c9.4-9.4 24.6-9.4 33.9 0l136 136c9.5 9.4 9.5 24.6.1 34zm192-34l-136-136c-9.4-9.4-24.6-9.4-33.9 0l-22.6 22.6c-9.4 9.4-9.4 24.6 0 33.9l96.4 96.4-96.4 96.4c-9.4 9.4-9.4 24.6 0 33.9l22.6 22.6c9.4 9.4 24.6 9.4 33.9 0l136-136c9.4-9.5 9.4-24.7 0-34z"/>
            </svg>
            <p class="text-lg">{item}</p>
          </li>
        ))}
      </ul>

      <a
        href={WA_URL}
        target="_blank"
        rel="noopener"
        data-event="whatsapp-click"
        class="inline-flex items-center justify-center gap-2 bg-rojo hover:bg-rojo-dark text-white font-bold px-8 md:px-10 py-4 rounded-lg text-lg transition-colors duration-300 shadow-hover mt-10"
      >
        <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor" aria-hidden="true">
          <path d="M16 3C9.373 3 4 8.373 4 15c0 2.25.62 4.36 1.7 6.16L4 29l8.05-1.65A11.9 11.9 0 0 0 16 27c6.627 0 12-5.373 12-12S22.627 3 16 3zm0 21.8c-1.9 0-3.68-.53-5.2-1.45l-.37-.22-4.78.98 1-4.65-.24-.39A9.77 9.77 0 0 1 6.2 15c0-5.4 4.4-9.8 9.8-9.8s9.8 4.4 9.8 9.8-4.4 9.8-9.8 9.8zm5.38-7.34c-.3-.15-1.74-.86-2-.96-.27-.1-.47-.15-.66.15-.2.29-.76.95-.93 1.15-.17.2-.34.22-.64.07-.3-.14-1.24-.45-2.36-1.45-.87-.78-1.46-1.74-1.63-2.03-.17-.3-.02-.46.13-.6.13-.14.3-.35.44-.52.15-.17.2-.3.3-.5.1-.19.05-.36-.02-.5-.08-.15-.67-1.6-.91-2.2-.24-.57-.48-.5-.66-.5h-.56c-.2 0-.5.07-.77.36-.26.29-1 .98-1 2.4 0 1.4 1.03 2.77 1.17 2.96.15.2 2.03 3.1 4.92 4.34.69.3 1.22.47 1.64.6.69.22 1.32.19 1.81.12.55-.08 1.74-.71 1.98-1.4.25-.68.25-1.27.17-1.4-.07-.12-.27-.2-.57-.34z"/>
        </svg>
        Quiero mi plan de pagos
      </a>
    </div>

    <div>
      <div class="relative mx-auto w-full max-w-[360px] aspect-[9/16] rounded-3xl overflow-hidden shadow-dark ring-8 ring-white/10 bg-black">
        <video
          id="charta-recorrido"
          class="w-full h-full object-cover"
          playsinline
          preload="none"
          poster="/videos/posters/charta-recorrido.jpg"
          data-src="/videos/charta-recorrido.mp4"
        ></video>
        <button
          type="button"
          data-play
          aria-label="Reproducir video del recorrido"
          class="absolute inset-0 flex flex-col items-center justify-center gap-3 bg-navy-dark/30 hover:bg-navy-dark/20 transition-colors"
        >
          <span class="flex items-center justify-center w-[72px] h-[72px] rounded-full bg-white">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="currentColor" class="text-navy translate-x-0.5" aria-hidden="true">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </span>
          <span class="text-white font-semibold">Ver recorrido</span>
        </button>
      </div>
      <p class="text-center text-sm text-white/70 mt-4">
        Recorrido por una cabaña en construcción con uno de nuestros clientes
      </p>
    </div>
  </div>
</section>

<script>
  const video = document.getElementById('charta-recorrido') as HTMLVideoElement | null;
  const button = document.querySelector<HTMLButtonElement>('#charta-recorrido ~ [data-play]');

  button?.addEventListener('click', () => {
    if (video) {
      if (!video.src) {
        const src = video.dataset.src;
        if (src) video.src = src;
      }
      video.muted = false;
      video.controls = true;
      video.play().catch(() => {});
    }
    button.style.display = 'none';
  });

  video?.addEventListener('ended', () => {
    if (button) button.style.display = 'flex';
  });
</script>
