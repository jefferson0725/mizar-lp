---

<section>
  <div class="bg-navy text-white px-6 py-5">
    <div class="max-w-6xl mx-auto flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
      <div class="flex items-center gap-3">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0" aria-hidden="true">
          <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/>
          <circle cx="12" cy="10" r="3"/>
        </svg>
        <div>
          <p class="font-serif text-xl">Charta, Santander</p>
          <p class="text-white/70 text-sm">A 5 minutos del pueblo</p>
        </div>
      </div>
      <a
        href="https://maps.app.goo.gl/958kctt7fkMLMWqm6"
        target="_blank"
        rel="noopener"
        class="underline underline-offset-4 hover:text-dorado"
      >
        Abrir en Google Maps
      </a>
    </div>
  </div>

  <div class="w-full overflow-hidden" style="height: clamp(280px, 45vw, 480px);">
    <iframe
      src="https://maps.google.com/maps?q=7.2793889,-72.9642778&z=15&hl=es&output=embed"
      width="100%"
      height="100%"
      style="border:0; display:block; min-height:280px;"
      loading="lazy"
      referrerpolicy="no-referrer-when-downgrade"
      allowfullscreen
      title="Ubicación de las parcelas campestres en Charta, Santander"
    ></iframe>
  </div>
</section>
