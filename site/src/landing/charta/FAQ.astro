---
// Preguntas frecuentes de las parcelas en Charta. El texto sale de ./faq.ts,
// el mismo array que alimenta el JSON-LD FAQPage de la página.
import { faqCharta } from "./faq";
---

<section id="preguntas-frecuentes" class="bg-gris-claro py-20 md:py-28 px-6">
  <div class="max-w-3xl mx-auto">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-rojo">Preguntas frecuentes</p>
    <h2 class="font-serif text-3xl md:text-5xl font-semibold leading-tight text-navy mt-4">
      Lo que preguntan antes de comprar una parcela en Charta
    </h2>

    <div class="bg-white rounded-2xl shadow-card px-6 py-2 mt-10">
      {faqCharta.map(({ q, a }) => (
        <details class="border-b border-navy/10 last:border-0 group">
          <summary class="flex items-center justify-between py-5 cursor-pointer gap-4 [list-style:none] [&::-webkit-details-marker]:hidden">
            <span class="font-semibold text-navy text-base md:text-lg">{q}</span>
            <span
              class="text-rojo text-2xl flex-shrink-0 transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <p class="text-gris-oscuro pb-5 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
