      <div class="flex flex-col items-center md:items-start gap-3">
        <img
          src="/assets/logo-mizar.webp"
          alt="Mizar · Diseño y Construcción"
          class="h-9 w-auto"
        />
        <p class="font-serif text-blanco text-lg tracking-wide">Mirador de la Montaña</p>
