          <span class="text-white text-sm">Calle 105 A # 23A - 18 Provenza, Bucaramanga, Santander</span>
        </li>
        <li class="flex items-center gap-3">
          <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
