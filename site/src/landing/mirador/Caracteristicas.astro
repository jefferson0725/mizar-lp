---
import { Image } from 'astro:assets';
import bonImg from '../../assets/mirador/Bono-5-millones-.webp';
import mapa from '../../assets/mirador/mapa.webp';

const WA_URL = "https://wa.me/573112658552?text=Hola%2C%20me%20interesan%20los%20lotes%20de%20Mirador%20de%20la%20Monta%C3%B1a%2C%20mi%20nombre%20es%20";

const caracteristicas = [
  {
    label: "Financiación Directa",
    descripcion: "Separa con 3 millones y paga cuotas a tu medida.",
  },
  {
    label: "Entrada Distintiva",
    descripcion: "Acceso exclusivo con imponente muro en piedra natural.",
  },
  {
    label: "Movilidad Óptima",
    descripcion: "Vías internas empedradas para fácil desplazamiento.",
  },
  {
    label: "Lotes Demarcados",
    descripcion: "Totalmente preparados para empezar a construir.",
  },
  {
    label: "Servicios Listos",
    descripcion: "Cada lote cuenta con conexión directa a agua potable y fácil acceso a energía eléctrica.",
  },
  {
    label: "Diseños Arquitectónicos Disponibles",
    descripcion: "Planos listos para edificar tu hogar ideal.",
  },
];
---

<section id="opciones" class="bg-white py-20 px-6">
  <div class="max-w-5xl mx-auto">

    <!-- Título centrado -->
    <div class="mb-10">
      <h2 class="reveal font-serif text-navy text-xl sm:text-2xl md:text-3xl text-center leading-tight">
        ¿Por qué elegir Mirador de la Montaña?
      </h2>
    </div>

    <!-- Video del proyecto (alojado en el propio sitio) con bono encima (esquina superior derecha).
         Antes apuntaba al WordPress viejo (mizar.com.co) y se sustituyó por error por el logo en
         blanco (mirador-de-la-montana.png), que es invisible sobre fondo blanco. -->
    <div class="reveal relative mb-10 rounded-2xl overflow-visible shadow-card">
      <video
        src="/videos/mirador-de-la-montana.mp4"
        poster="/videos/posters/mirador-de-la-montana.jpg"
        controls
        playsinline
        preload="none"
        controlslist="nodownload"
        width="1280"
        height="720"
        aria-label="Video de presentación de Mirador de la Montaña"
        class="w-full aspect-video block rounded-2xl bg-navy object-cover"
      ></video>
      <!-- Bono badge solapando la esquina superior derecha de la imagen -->
      <div class="absolute -top-6 right-2 md:right-0 md:translate-x-1/2 z-10">
        <Image
          src={bonImg}
          alt="Bono especial de $5.000.000 en Mirador de la Montaña"
          class="w-20 md:w-40"
          loading="lazy"
        />
      </div>
    </div>

    <!-- Mapa (izquierda) + Características (derecha) -->
    <div class="reveal flex flex-col md:flex-row gap-8 md:gap-12 items-start mb-12">

      <!-- Mapa — ocupa la mitad izquierda -->
      <div class="w-full md:w-1/2">
        <Image
          src={mapa}
          alt="Mapa de lotes de Mirador de la Montaña en Mesa de los Santos"
          class="rounded-2xl shadow-card w-full"
          loading="lazy"
        />
      </div>

      <!-- Lista de características — mitad derecha -->
      <ul class="w-full md:w-1/2 space-y-5">
        {caracteristicas.map(({ label, descripcion }, i) => (
          <li class="reveal flex items-start gap-3" style={`transition-delay: ${i * 0.08}s`}>
            <svg class="w-5 h-5 text-rojo flex-shrink-0 mt-1" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="12" cy="12" r="10"/>
              <path d="m9 12 2 2 4-4"/>
            </svg>
            <p class="text-gris-oscuro text-base leading-relaxed">
              <strong class="text-navy">{label}:</strong> {descripcion}
            </p>
          </li>
        ))}
      </ul>

    </div>

    <!-- CTA centrado bajo el grid -->
    <div class="text-center">
      <a
        href={WA_URL}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-rojo hover:bg-rojo-dark text-white font-bold px-10 py-4 rounded-lg text-lg transition-colors duration-300 shadow-hover"
        data-event="whatsapp-click"
      >
        ¡Asegura el tuyo antes de que se agoten!
      </a>
    </div>
  </div>
</section>
