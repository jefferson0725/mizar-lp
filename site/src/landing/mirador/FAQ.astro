---
// Preguntas frecuentes de Mirador de la Montaña. El texto sale de ./faq.ts,
// el mismo array que alimenta el JSON-LD FAQPage de la página.
import { faqMirador } from "./faq";
---

<section id="preguntas-frecuentes" class="py-20 px-6 bg-white">
  <div class="max-w-3xl mx-auto">
    <h2 class="reveal font-serif text-navy text-2xl sm:text-3xl md:text-4xl text-center mb-10 leading-tight">
      Preguntas frecuentes sobre los lotes en Mesa de los Santos
    </h2>

    <div class="bg-crema rounded-2xl px-6 py-2 shadow-sm">
      {faqMirador.map(({ q, a }) => (
        <details class="border-b border-navy/10 last:border-0 group">
          <summary class="flex items-center justify-between py-5 cursor-pointer gap-4 [list-style:none] [&::-webkit-details-marker]:hidden">
            <span class="font-semibold text-navy text-base md:text-lg">{q}</span>
            <span
              class="faq-icon text-navy text-2xl flex-shrink-0 transition-transform duration-300 group-open:rotate-45"
              aria-hidden="true"
            >+</span>
          </summary>
          <p class="text-gris-oscuro/80 pb-5 leading-relaxed">{a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
