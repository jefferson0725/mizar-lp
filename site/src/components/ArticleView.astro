---
/**
 * Ficha de un artículo del blog (cabecera, imagen principal y cuerpo).
 * La usan /blog/[slug]/ y la vista previa de borradores (/vista-previa/blog/), así ambas
 * se ven idénticas. Los datos llegan ya preparados por toArticleView() (src/lib/article.ts).
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ArticleView } from '../lib/article';

/**
 * Artículos de Strapi y de la vista previa: contentHtml (HTML ya convertido) + heroUrl.
 * Artículos en archivo (.md): heroImage (astro:assets) y el cuerpo llega por el slot.
 */
type Props = Omit<ArticleView, 'contentHtml' | 'heroUrl'> & {
  contentHtml?: string;
  heroUrl?: string | null;
  heroImage?: ImageMetadata;
  heroPosition?: string;
};

const { eyebrow, title, description, meta, heroUrl, heroAlt, contentHtml, heroImage, heroPosition } = Astro.props;
---

<article class="bg-cream">
  <header class="bg-plum-dark py-16 text-white md:py-24">
    <div class="container-site max-w-prose">
      <p class="eyebrow text-gold">{eyebrow}</p>
      <h1 class="display-xl mt-4 text-4xl md:text-6xl">{title}</h1>
      <p class="mt-6 text-lg text-white/80">{description}</p>
      <p class="mt-6 text-sm font-semibold text-white/65">
        {meta}
      </p>
    </div>
  </header>

  {heroImage ? (
    <Image
      class="w-full max-h-[480px] object-cover"
      src={heroImage}
      alt={heroAlt}
      style={heroPosition ? `object-position: ${heroPosition}` : undefined}
      width={1200}
      format="webp"
      loading="eager"
    />
  ) : heroUrl && (
    <img
      class="w-full max-h-[480px] object-cover"
      src={heroUrl}
      alt={heroAlt}
      loading="eager"
      width="1200"
      height="480"
    />
  )}

  <div class="container-site max-w-prose py-12 md:py-16">
    {
      contentHtml !== undefined ? (
        <div class="prose prose-lg max-w-none article-body" set:html={contentHtml} />
      ) : (
        <div class="prose prose-lg max-w-none article-body">
          <slot />
        </div>
      )
    }
  </div>
</article>

<style>
  /* YouTube facade */
  .article-body :global(.yt-facade) {
    position: relative;
    margin-top: 1.5rem;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #000;
    cursor: pointer;
  }
  .article-body :global(.yt-facade img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .article-body :global(.yt-play) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: white;
    font-size: 3.5rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .article-body :global(.yt-play:hover) { background: rgba(0, 0, 0, 0.55); }
  .article-body :global(.yt-facade iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.querySelector('.yt-play')?.addEventListener('click', () => {
      const id = el.dataset.id;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.innerHTML = '';
      el.appendChild(iframe);
    });
  });
</script>
