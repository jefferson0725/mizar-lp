---
/**
 * Plantilla de la vista previa de borradores del blog (botón «Previsualización» de Strapi).
 *
 * Se compila como página estática con marcadores __MZPV_*__ en lugar de los datos. En
 * Cloudflare, la función site/functions/vista-previa/[[path]].ts intercepta /vista-previa/*,
 * comprueba la firma del enlace, pide el borrador a Strapi y sustituye los marcadores.
 * Así la vista previa usa el MISMO layout, componente, estilos y scripts que /blog/[slug]/.
 *
 * Sin la función (hosting de respaldo) esta página no debe publicarse: los deploys de
 * respaldo excluyen /vista-previa/. No va en el sitemap (astro.config.mjs).
 */
import Base from '../../../layouts/Base.astro';
import ArticleView from '../../../components/ArticleView.astro';

// Si cambian, actualizar también site/functions/vista-previa/[[path]].ts
const M = (name: string) => `__MZPV_${name}__`;
---

<Base
  title={`${M('TITLE')} | Grupo Mizar`}
  description={M('DESCRIPTION')}
  path={`/blog/${M('SLUG')}`}
  noindex
  analytics={false}
  navPath="/blog/"
>
  <ArticleView
    eyebrow={M('EYEBROW')}
    title={M('TITLE')}
    description={M('DESCRIPTION')}
    meta={M('META')}
    heroUrl={M('HERO')}
    heroAlt={M('HEROALT')}
    contentHtml={M('CONTENT')}
  />
  <p
    style="position:fixed;left:12px;bottom:12px;z-index:60;margin:0;padding:6px 12px;border-radius:999px;background:#1f1a24;color:#fff;font:600 12px/1.4 system-ui,sans-serif;box-shadow:0 2px 8px rgba(0,0,0,.25);pointer-events:none"
  >
    Vista previa · __MZPV_STATUS__
  </p>
</Base>

<script is:inline>
  // Strapi avisa con «strapiUpdate» cuando se guarda el artículo: recargar para ver el cambio.
  window.addEventListener('message', function (e) {
    if (e.data && e.data.type === 'strapiUpdate') window.location.reload();
  });
</script>
