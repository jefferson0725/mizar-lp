---
import LandingReact from "../layouts/LandingReact.astro";
import Header from "../components/Header.astro";
import Hero from "../landing/mirador/Hero.astro";
import Caracteristicas from "../landing/mirador/Caracteristicas.astro";
import Financiacion from "../landing/mirador/Financiacion.astro";
import Mapa from "../landing/mirador/Mapa.astro";
import LandingFooter from "../landing/mirador/Footer.astro";
import { breadcrumbSchema } from "../data/schema";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { getWhatsAppConfig } from "../data/whatsapp";
const wa = getWhatsAppConfig('/mirador-de-la-montana');
---

<LandingReact
  title="Lotes en Mesa de los Santos desde $75 millones | Mirador"
  description="Lotes campestres en Mesa de los Santos desde $75 millones, a 15 min del peaje. Vías empedradas, agua potable y planos. Separa con $3.000.000, sin bancos."
  ogImage="/assets/mirador-de-la-montana.png"
  path="/mirador-de-la-montana"
  headerColor="#2f4a3c"
  headerColorDark="#1e3327"
  schema={[
    breadcrumbSchema([["Proyectos", "/proyectos/"], ["Mirador de la Montaña", "/mirador-de-la-montana/"]]),
  ]}
>
  <div class="theme-mirador">
    <Header transparent />
    <Hero />
    <Caracteristicas />
    <Financiacion />
    <Mapa />
    <LandingFooter />
  </div>
  <WhatsAppFloat phone={wa.phone} message={wa.message} />
</LandingReact>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
  }
</script>
