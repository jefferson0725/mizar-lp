---
import LandingReact from "../layouts/LandingReact.astro";
import Header from "../components/Header.astro";
import Hero from "../landing/charta/Hero.astro";
import Sonando from "../landing/charta/Sonando.astro";
import Galeria from "../landing/charta/Galeria.astro";
import Parcela from "../landing/charta/Parcela.astro";
import Mapa from "../landing/charta/Mapa.astro";
import Financiacion from "../landing/charta/Financiacion.astro";
import Cabana from "../landing/charta/Cabana.astro";
import Testimonio from "../landing/charta/Testimonio.astro";
import Cierre from "../landing/charta/Cierre.astro";
import LandingFooter from "../landing/charta/Footer.astro";
import { breadcrumbSchema } from "../data/schema";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { getWhatsAppConfig } from "../data/whatsapp";
const wa = getWhatsAppConfig('/parcelas-charta');
---

<LandingReact
  title="Parcelas en Charta, Santander, a cuotas y sin bancos | Mizar"
  description="Parcelas en Charta, Santander, desde 650 m² y a 1 hora de Bucaramanga, con agua, luz, alcantarillado y planos de tu cabaña. A cuotas con Mizar, sin bancos."
  ogImage="/assets/parcelas-charta.jpg"
  path="/parcelas-charta"
  headerColor="#1f3a31"
  headerColorDark="#142720"
  schema={[
    breadcrumbSchema([["Proyectos", "/proyectos/"], ["Parcelas en Charta", "/parcelas-charta/"]]),
  ]}
>
  <div class="theme-charta">
    <Header transparent />
    <Hero />
    <Sonando />
    <Mapa />
    <Galeria />
    <Parcela />
    <Financiacion />
    <Cabana />
    <Testimonio />
    <Cierre />
    <LandingFooter />
  </div>
  <WhatsAppFloat phone={wa.phone} message={wa.message} />
</LandingReact>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
  }
</script>
