---
import { Image } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { formatDate } from '../../lib/article';
import { getAllPosts, STRAPI_URL, type BlogItem } from '../../lib/posts';

// Archivos del repo + Strapi (opcional), sin repetidos y el más reciente primero.
const posts: BlogItem[] = await getAllPosts();

// Portada de la tarjeta de Strapi: versión mediana (~750 px), no la original.
function strapiCardImage(p: BlogItem): string | null {
  const h = p.strapi?.hero_image;
  const src = h?.formats?.medium?.url ?? h?.formats?.small?.url ?? h?.url;
  if (!src) return null;
  return src.startsWith('http') ? src : `${STRAPI_URL}${src}`;
}

const site = Astro.site ?? new URL('https://grupomizar.com.co');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
  ],
};
---

<Base
  title="Blog inmobiliario | Grupo Mizar"
  description="Guías de Grupo Mizar para comprar propiedad en Colombia a cuotas y sin bancos: apartamentos VIS, inversión desde el exterior y respaldo de constructora."
  path="/blog"
  schema={schema}
>
  <section class="bg-plum-dark py-16 text-white md:py-24">
    <div class="container-site">
      <p class="eyebrow text-gold">Blog Mizar</p>
      <h1 class="display-xl mt-4 max-w-4xl text-4xl md:text-6xl">
        Respuestas claras para comprar propiedad en Colombia, a cuotas y sin bancos
      </h1>
      <p class="mt-6 max-w-prose text-lg text-white/80">
        Contenido práctico para trabajadores colombianos, familias en Santander y Norte de
        Santander, y colombianos en el exterior que quieren invertir con respaldo local.
      </p>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="container-site">
      {
        posts.length === 0 ? (
          <p class="text-ink/50">Próximamente nuevos artículos.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-3">
            {posts.map((p) => (
              <article class="overflow-hidden rounded-2xl border border-ink/10 bg-white">
                {p.file?.data.hero_image ? (
                  <a href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
                    <Image
                      class="aspect-[16/9] w-full object-cover"
                      src={p.file.data.hero_image}
                      alt={p.file.data.hero_alt || p.title}
                      width={750}
                      height={422}
                      format="webp"
                      loading="lazy"
                    />
                  </a>
                ) : (
                  strapiCardImage(p) && (
                    <a href={`/blog/${p.slug}/`} tabindex="-1" aria-hidden="true">
                      <img
                        class="aspect-[16/9] w-full object-cover"
                        src={strapiCardImage(p)}
                        alt={p.strapi?.hero_image?.alternativeText || p.title}
                        loading="lazy"
                        width="750"
                        height="422"
                      />
                    </a>
                  )
                )}
                <div class="p-6">
                <p class="eyebrow text-teal">{p.frente.replace(/-/g, ' ')}</p>
                <h2 class="display-lg mt-4 text-2xl">
                  <a class="hover:text-mizar" href={`/blog/${p.slug}/`}>
                    {p.title}
                  </a>
                </h2>
                <p class="mt-3 text-sm font-semibold text-ink/60">{formatDate(p.pubDate)}</p>
                <p class="mt-4 text-ink/75">{p.description}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {p.tags.slice(0, 2).map((t) => (
                    <span class="rounded-full bg-cream px-3 py-1 text-sm font-semibold text-plum">
                      {t}
                    </span>
                  ))}
                </div>
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
