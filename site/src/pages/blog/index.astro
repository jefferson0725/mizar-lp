---
import Base from '../../layouts/Base.astro';

const STRAPI_URL = import.meta.env.STRAPI_URL ?? 'http://localhost:1337';

interface Post {
  id: number;
  slug: string;
  title: string;
  description: string;
  frente: string;
  tags: string;
  pub_date: string;
}

let posts: Post[] = [];
try {
  const res = await fetch(
    `${STRAPI_URL}/api/posts?sort=pub_date:desc&pagination[pageSize]=100`,
  );
  if (res.ok) {
    const { data } = await res.json();
    posts = data ?? [];
  }
} catch (e) {
  console.warn('[blog/index] No se pudo cargar posts de Strapi en build:', e);
}

function formatDate(d: string) {
  return new Intl.DateTimeFormat('es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date(d));
}

const site = Astro.site ?? new URL('https://mizar.com.co');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', site).href },
  ],
};
---

<Base
  title="Blog inmobiliario | Grupo Mizar"
  description="Guías de Grupo Mizar para comprar propiedad en Colombia a cuotas y sin bancos: apartamentos VIS, inversión desde el exterior y respaldo de constructora."
  path="/blog"
  schema={schema}
>
  <section class="bg-plum-dark py-16 text-white md:py-24">
    <div class="container-site">
      <p class="eyebrow text-gold">Blog Mizar</p>
      <h1 class="display-xl mt-4 max-w-4xl text-4xl md:text-6xl">
        Respuestas claras para comprar propiedad en Colombia, a cuotas y sin bancos
      </h1>
      <p class="mt-6 max-w-prose text-lg text-white/80">
        Contenido práctico para trabajadores colombianos, familias en Santander y Norte de
        Santander, y colombianos en el exterior que quieren invertir con respaldo local.
      </p>
    </div>
  </section>

  <section class="bg-cream py-16 md:py-24">
    <div class="container-site">
      {
        posts.length === 0 ? (
          <p class="text-ink/50">Próximamente nuevos artículos.</p>
        ) : (
          <div class="grid gap-6 md:grid-cols-3">
            {posts.map((p) => (
              <article class="rounded-2xl border border-ink/10 bg-white p-6">
                <p class="eyebrow text-teal">{p.frente?.replace(/-/g, ' ')}</p>
                <h2 class="display-lg mt-4 text-2xl">
                  <a class="hover:text-mizar" href={`/blog/${p.slug}/`}>
                    {p.title}
                  </a>
                </h2>
                <p class="mt-3 text-sm font-semibold text-ink/60">{formatDate(p.pub_date)}</p>
                <p class="mt-4 text-ink/75">{p.description}</p>
                <div class="mt-6 flex flex-wrap gap-2">
                  {(p.tags ?? '').split(',').map((t) => t.trim()).filter(Boolean).map((t) => (
                    <span class="rounded-full bg-cream px-3 py-1 text-sm font-semibold text-plum">
                      {t}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>
        )
      }
    </div>
  </section>
</Base>
