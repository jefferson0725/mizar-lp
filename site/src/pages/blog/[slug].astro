---
import { renderBlocks } from '../../lib/renderBlocks';
import Base from '../../layouts/Base.astro';

const STRAPI_URL = (import.meta.env.STRAPI_URL ?? 'http://localhost:1337').trim();

export async function getStaticPaths() {
  const strapiUrl = (import.meta.env.STRAPI_URL ?? 'http://localhost:1337').trim();
  try {
    const res = await fetch(
      `${strapiUrl}/api/posts?populate=hero_image&sort=pub_date:desc&pagination[pageSize]=100`,
    );
    if (!res.ok) return [];
    const { data } = await res.json();
    return (data ?? []).map((post: Record<string, unknown>) => ({
      params: { slug: post.slug as string },
      props: { post },
    }));
  } catch (e) {
    console.warn('[blog/[slug]] No se pudo obtener posts de Strapi:', e);
    return [];
  }
}

interface HeroImage {
  url: string;
  alternativeText?: string;
  width?: number;
  height?: number;
}

interface Post {
  id: number;
  documentId: string;
  slug: string;
  title: string;
  description: string;
  content: unknown[];
  author: string;
  frente: string;
  tags: string;
  hero_image: HeroImage | null;
  pub_date: string;
  publishedAt: string;
  updatedAt: string;
}

const { post } = Astro.props as { post: Post };

// Resolver URL de hero_image (Strapi puede devolver rutas relativas)
const heroUrl = post.hero_image
  ? post.hero_image.url.startsWith('http')
    ? post.hero_image.url
    : `${STRAPI_URL}${post.hero_image.url}`
  : null;
const heroAlt = post.hero_image?.alternativeText || post.title;

// Bloques JSON de Strapi → HTML
const content = renderBlocks((post.content ?? []) as Parameters<typeof renderBlocks>[0]);

const site = Astro.site ?? new URL('https://mizar.com.co');
const path = `/blog/${post.slug}`;
const canonical = new URL(path, site).href;

const formatDate = (date: string) =>
  new Intl.DateTimeFormat('es-CO', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  }).format(new Date(date));

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  author: { '@type': 'Organization', name: post.author ?? 'Grupo Mizar' },
  publisher: {
    '@type': 'Organization',
    name: 'Grupo Mizar',
    logo: { '@type': 'ImageObject', url: new URL('/logo-mizar.webp', site).href },
  },
  datePublished: new Date(post.pub_date).toISOString(),
  dateModified: new Date(post.updatedAt ?? post.pub_date).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  keywords: (post.tags ?? '').split(',').map((t) => t.trim()).filter(Boolean),
};

if (heroUrl) {
  articleSchema.image = [heroUrl];
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog', site).href },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---

<Base
  title={`${post.title} | Grupo Mizar`}
  description={post.description}
  path={path}
  ogImage={heroUrl ?? undefined}
  schema={[articleSchema, breadcrumbSchema]}
>
  <article class="bg-cream">
    <header class="bg-plum-dark py-16 text-white md:py-24">
      <div class="container-site max-w-prose">
        <p class="eyebrow text-gold">{post.frente?.replace(/-/g, ' ')}</p>
        <h1 class="display-xl mt-4 text-4xl md:text-6xl">{post.title}</h1>
        <p class="mt-6 text-lg text-white/80">{post.description}</p>
        <p class="mt-6 text-sm font-semibold text-white/65">
          {formatDate(post.pub_date)} · {post.author ?? 'Grupo Mizar'}
        </p>
      </div>
    </header>

    {heroUrl && (
      <img
        class="w-full max-h-[480px] object-cover"
        src={heroUrl}
        alt={heroAlt}
        loading="eager"
        width="1200"
        height="480"
      />
    )}

    <div class="container-site max-w-prose py-12 md:py-16">
      <div class="prose prose-lg max-w-none article-body" set:html={content} />
    </div>
  </article>
</Base>

<style>
  /* YouTube facade */
  .article-body :global(.yt-facade) {
    position: relative;
    margin-top: 1.5rem;
    border-radius: 12px;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: #000;
    cursor: pointer;
  }
  .article-body :global(.yt-facade img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .article-body :global(.yt-play) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    background: rgba(0, 0, 0, 0.35);
    border: none;
    color: white;
    font-size: 3.5rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .article-body :global(.yt-play:hover) { background: rgba(0, 0, 0, 0.55); }
  .article-body :global(.yt-facade iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.yt-facade').forEach((el) => {
    el.querySelector('.yt-play')?.addEventListener('click', () => {
      const id = el.dataset.id;
      if (!id) return;
      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube.com/embed/${id}?autoplay=1`;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
      iframe.allowFullscreen = true;
      el.innerHTML = '';
      el.appendChild(iframe);
    });
  });
</script>
