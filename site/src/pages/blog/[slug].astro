---
import { render } from 'astro:content';
import { getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ArticleView from '../../components/ArticleView.astro';
import { toArticleView, formatDate } from '../../lib/article';
import { getAllPosts, STRAPI_URL, type BlogItem } from '../../lib/posts';
import { extractFaq, faqSchema } from '../../lib/faq';

export async function getStaticPaths() {
  const posts = await getAllPosts();
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props as { post: BlogItem };

const site = Astro.site ?? new URL('https://grupomizar.com.co');

// Dos orígenes, misma ficha: archivo (.md, imagen por astro:assets) o Strapi (bloques JSON).
let view;
let heroUrl: string | null = null;
let Content: Awaited<ReturnType<typeof render>>['Content'] | undefined;

if (post.file) {
  const { hero_image, hero_alt, hero_position } = post.file.data;
  ({ Content } = await render(post.file));
  view = {
    eyebrow: post.frente.replace(/-/g, ' '),
    title: post.title,
    description: post.description,
    meta: `${formatDate(post.pubDate)} · ${post.author}`,
    heroAlt: hero_alt || post.title,
    heroImage: hero_image,
    heroPosition: hero_position,
  };
  if (hero_image) {
    // Imagen para Open Graph y JSON-LD: JPG (WhatsApp y LinkedIn no siempre leen webp).
    const og = await getImage({ src: hero_image, width: 1200, format: 'jpg' });
    heroUrl = new URL(og.src, site).href;
  }
} else {
  // Misma preparación de datos que la vista previa de borradores (src/lib/article.ts).
  view = toArticleView(post.strapi!, STRAPI_URL);
  heroUrl = view.heroUrl;
}

const path = `/blog/${post.slug}/`;
const canonical = new URL(path, site).href;

// Fechas planas (YYYY-MM-DD): con hora UTC "T00:00Z" Colombia las leería como el día anterior.
const datePublished = post.pubDate.slice(0, 10);
const dateModified = post.modDate.slice(0, 10);

const ORG_ID = 'https://grupomizar.com.co/#organizacion'; // mismo @id que orgSchema (src/data/schema.ts)
const publisher = {
  '@type': 'Organization',
  '@id': ORG_ID,
  name: 'Grupo Mizar',
  logo: { '@type': 'ImageObject', url: new URL('/logo-mizar.webp', site).href },
};
const author =
  post.author === 'Grupo Mizar'
    ? { '@type': 'Organization', '@id': ORG_ID, name: 'Grupo Mizar', url: new URL('/nosotros/', site).href }
    : { '@type': 'Person', name: post.author };

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  author,
  publisher,
  datePublished,
  dateModified,
  inLanguage: 'es-CO',
  mainEntityOfPage: canonical,
  url: canonical,
  keywords: post.tags,
};

if (heroUrl) {
  articleSchema.image = [heroUrl];
}

// FAQPage: solo artículos en archivo con sección «Preguntas frecuentes»; se arma desde el HTML renderizado.
const schemas: object[] = [articleSchema];
if (post.file) {
  const faq = extractFaq(post.file.rendered?.html ?? '');
  console.log(`[faq] ${post.slug}: ${faq.length} pregunta(s) encontradas`);
  if (faq.length >= 2) schemas.push(faqSchema(faq));
  else if (/Preguntas frecuentes/i.test(post.file.body ?? '')) {
    console.warn(`[faq] ${post.slug}: menos de 2 pares P/R, no se emite FAQPage`);
  }
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---

<Base
  title={post.file?.data.seo_title ?? `${post.title} | Grupo Mizar`}
  description={post.description}
  path={path}
  ogImage={heroUrl ?? undefined}
  schema={[...schemas, breadcrumbSchema]}
  ogType="article"
  articlePublished={datePublished}
  articleModified={dateModified}
>
  <ArticleView {...view}>
    {Content && <Content />}
  </ArticleView>
</Base>
