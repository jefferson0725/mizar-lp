---
import Base from '../../layouts/Base.astro';
import ArticleView from '../../components/ArticleView.astro';
import { toArticleView, type Post } from '../../lib/article';

const STRAPI_URL = (import.meta.env.STRAPI_URL ?? 'http://localhost:1337').trim();

export async function getStaticPaths() {
  const strapiUrl = (import.meta.env.STRAPI_URL ?? 'http://localhost:1337').trim();
  try {
    const res = await fetch(
      `${strapiUrl}/api/posts?populate=hero_image&sort=pub_date:desc&pagination[pageSize]=100`,
    );
    if (!res.ok) return [];
    const { data } = await res.json();
    return (data ?? []).map((post: Record<string, unknown>) => ({
      params: { slug: post.slug as string },
      props: { post },
    }));
  } catch (e) {
    console.warn('[blog/[slug]] No se pudo obtener posts de Strapi:', e);
    return [];
  }
}

const { post } = Astro.props as { post: Post };

// Misma preparación de datos que la vista previa de borradores (src/lib/article.ts).
const view = toArticleView(post, STRAPI_URL);
const heroUrl = view.heroUrl;

const site = Astro.site ?? new URL('https://grupomizar.com.co');
const path = `/blog/${post.slug}/`;
const canonical = new URL(path, site).href;

const articleSchema: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.description,
  author: { '@type': 'Organization', name: post.author ?? 'Grupo Mizar' },
  publisher: {
    '@type': 'Organization',
    name: 'Grupo Mizar',
    logo: { '@type': 'ImageObject', url: new URL('/logo-mizar.webp', site).href },
  },
  datePublished: post.pub_date ? new Date(post.pub_date).toISOString() : new Date(post.publishedAt).toISOString(),
  dateModified: new Date(post.updatedAt ?? post.pub_date).toISOString(),
  mainEntityOfPage: canonical,
  url: canonical,
  keywords: (post.tags ?? '').split(',').map((t) => t.trim()).filter(Boolean),
};

if (heroUrl) {
  articleSchema.image = [heroUrl];
}

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Inicio', item: new URL('/', site).href },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', site).href },
    { '@type': 'ListItem', position: 3, name: post.title, item: canonical },
  ],
};
---

<Base
  title={`${post.title} | Grupo Mizar`}
  description={post.description}
  path={path}
  ogImage={heroUrl ?? undefined}
  schema={[articleSchema, breadcrumbSchema]}
>
  <ArticleView {...view} />
</Base>
