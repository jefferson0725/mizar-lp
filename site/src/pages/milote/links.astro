---
import LandingReact from "../../layouts/LandingReact.astro";
import Enlaces from "../../landing/milote-links/Enlaces.astro";
---

<LandingReact
  title="Mi Lote Cúcuta · Lotes a cuotas sin intereses | Enlaces"
  description="Enlaces oficiales de Mi Lote en Cúcuta: lotes en San Cayetano a cuotas sin intereses, WhatsApp y redes sociales. Un proyecto de Grupo Mizar."
  ogImage="/og-default.jpg"
  path="/milote/links"
  headerColor="#2f2b27"
  headerColorDark="#2f2b27"
  noindex
>
  <Enlaces />
</LandingReact>

<style is:global>
  html, body { background-color: #2f2b27; }
  .lnk-in { opacity: 0; transform: translateY(12px); animation: lnk-in 0.5s ease forwards; }
  @keyframes lnk-in { to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .lnk-in { opacity: 1; transform: none; animation: none; } }
</style>
