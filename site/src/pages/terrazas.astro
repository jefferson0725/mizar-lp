---
import LandingReact from "../layouts/LandingReact.astro";
import Header from "../components/Header.astro";
import IntroParallax from "../landing/terrazas/IntroParallax.astro";
import Testimonios from "../landing/terrazas/Testimonios.astro";
import Comentarios from "../landing/terrazas/Comentarios.astro";
import Ubicacion from "../landing/terrazas/Ubicacion.astro";
import Apartamentos from "../landing/terrazas/components/Apartamentos.jsx";
import QuienesSomos from "../landing/terrazas/QuienesSomos.astro";
import Precios from "../landing/terrazas/Precios.astro";
import FAQ from "../landing/terrazas/FAQ.astro";
import Resumen from "../landing/terrazas/Resumen.astro";
import Contacto from "../landing/terrazas/Contacto.astro";
import TerrazasFooter from "../landing/terrazas/Footer.astro";
import { breadcrumbSchema, faqSchema, proyectoSchema } from "../data/schema";
import { faqTerrazas } from "../landing/terrazas/faq";
import WhatsAppFloat from "../components/WhatsAppFloat.astro";
import { getWhatsAppConfig } from "../data/whatsapp";
const wa = getWhatsAppConfig('/terrazas');
---

<LandingReact
  title="Apartamentos sobre planos en Piedecuesta | Terrazas de la Cantera"
  description="Apartamentos sobre planos en Piedecuesta con vista al Cerro de La Cantera: 60 m², 3 alcobas, a cuotas y sin bancos, directo con Mizar. Entrega diciembre 2027."
  ogImage="/og/terrazas.jpg"
  path="/terrazas"
  headerColor="#025362"
  headerColorDark="#013a45"
  schema={[
    breadcrumbSchema([["Proyectos", "/proyectos/"], ["Terrazas de la Cantera", "/terrazas/"]]),
    proyectoSchema({
      path: "/terrazas/",
      nombre: "Terrazas de la Cantera",
      descripcion: "Apartamentos de 3 alcobas y 60,47 m² en el centro de Piedecuesta, Santander. Se separan con $2.000.000 y se pagan a cuotas directo con Mizar, sin bancos.",
      municipio: "Piedecuesta",
      departamento: "Santander",
      imagen: "/og/terrazas.jpg",
      mapa: "https://maps.google.com/maps?q=Terrazas+de+la+Cantera+Piedecuesta",
      unidad: { tipo: "apartamento", nombre: "Apartamento de 3 alcobas en Piedecuesta", alcobas: 3, banos: 2, areaM2: [60.47] },
    }),
    faqSchema(faqTerrazas),
  ]}
>
  <Header transparent />
  <!-- .theme-terrazas sobreescribe los tokens CSS (navy → teal, rojo → lima) -->
  <div class="theme-terrazas">
    <IntroParallax />
    <Testimonios />
    <Comentarios />
    <Ubicacion />
    <Apartamentos client:visible />
    <QuienesSomos />
    <Precios />
    <FAQ />
    <Resumen />
    <Contacto />
    <TerrazasFooter />
    <WhatsAppFloat phone={wa.phone} message={wa.message} />
  </div>
</LandingReact>

<script>
  // Reveal on scroll — activa .in-view en elementos .reveal al entrar al viewport.
  // Respeta prefers-reduced-motion.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduced) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('in-view');
          }
        });
      },
      { threshold: 0.12 }
    );
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
  } else {
    // Si prefiere reduced-motion, mostrar todo inmediatamente
    document.querySelectorAll('.reveal').forEach((el) => el.classList.add('in-view'));
  }
</script>
