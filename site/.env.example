# URL del CMS Strapi que alimenta el blog (/blog y /blog/[slug]).
# Si se deja vacío, el build usa http://localhost:1337 y el blog queda sin artículos.
# En producción se inyecta desde el secret STRAPI_URL de GitHub Actions.
STRAPI_URL=

# ID de medición de Google Analytics 4 (formato G-XXXXXXXXXX).
# Debe llevar el prefijo PUBLIC_ para que Astro lo exponga al navegador.
PUBLIC_GA4_ID=

